[Unit]
Description=Synchronize verified HTTPS certificates to LAN gateways
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/home-nav-lan-cert-sync.py --config /etc/home-nav/lan-cert-sync.json
UMask=0077
TimeoutStartSec=8min
